DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devsoul_db?schema=public"

# Firma de la cookie de sesión (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Contraseñas iniciales de los socios (solo se usan al crear el usuario con `npx prisma db seed`)
SEED_PASSWORD_MARCE=
SEED_PASSWORD_LAUTARO=

OPENAI_API_KEY=
