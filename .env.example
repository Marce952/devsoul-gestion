DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devsoul_db?schema=public"

# Firma de la cookie de sesión (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Contraseñas iniciales de los socios (solo se usan al crear el usuario con `npx prisma db seed`)
SEED_PASSWORD_MARCE=
SEED_PASSWORD_LAUTARO=

# Cotización USD automática (dolarapi.com / argentinadatos.com): oficial | bolsa (MEP) | blue | contadoconliqui | cripto
EXCHANGE_RATE_CASA=oficial

# Tareas programadas (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>"). Mínimo 16 caracteres.
CRON_SECRET=

# Facturación recurrente: día de vencimiento de las facturas mensuales
INVOICE_DUE_DAY=10

# Recordatorios por email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Devsoul <facturacion@tudominio.com>"
EMAIL_REPLY_TO=
REMINDER_DAYS_BEFORE=3
REMINDER_DAYS_AFTER=7

OPENAI_API_KEY=
