generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FINANCIAL
}

enum SoftwareType {
  SAAS
  CUSTOM
}

enum ContractType {
  SAAS_SUBSCRIPTION
  MAINTENANCE
  CUSTOM_DEVELOPMENT
}

enum PaymentStatus {
  PAID
  PENDING
}

enum Currency {
  ARS
  USD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

enum AccountProvider {
  UALA
  BANK
  CASH
  OTHER
}

enum TransactionSource {
  MANUAL
  INVOICE
  TRANSFER
  UALA_IMPORT
  UALA_WEBHOOK
}

enum RateSource {
  MANUAL
  API
}

enum ReminderKind {
  BEFORE_DUE
  DUE_DAY
  OVERDUE
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         Role
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id          String     @id @default(cuid())
  companyName String
  contactName String
  email       String     @unique
  phone       String?
  status      Boolean    @default(true)
  contracts   Contract[]
  tickets     Ticket[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Software {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        SoftwareType
  basePrice   Decimal      @db.Decimal(12, 2)
  contracts   Contract[]
  tickets     Ticket[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Contract {
  id          String       @id @default(cuid())
  clientId    String
  softwareId  String
  type        ContractType
  totalAmount Decimal      @db.Decimal(12, 2)
  currency    Currency
  active      Boolean      @default(true)
  startDate   DateTime
  endDate     DateTime?
  invoices    Invoice[]
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software     @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([softwareId])
  @@index([active])
  @@index([deletedAt])
}

model Invoice {
  id           String        @id @default(cuid())
  contractId   String
  amount       Decimal       @db.Decimal(12, 2)
  dueDate      DateTime
  status       PaymentStatus @default(PENDING)
  currency     Currency
  period       String
  paymentDate  DateTime?
  rateToArs    Decimal?      @db.Decimal(14, 4)
  recurringKey String?       @unique
  transaction  Transaction?
  reminders    ReminderLog[]
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@index([period])
}

model FinancialAccount {
  id             String          @id @default(cuid())
  name           String          @unique
  provider       AccountProvider
  currency       Currency
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingDate    DateTime
  active         Boolean         @default(true)
  transactions   Transaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TransactionCategory {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  active       Boolean         @default(true)
  transactions Transaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([name, type])
}

model ExchangeRate {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  currency  Currency
  rateToArs Decimal    @db.Decimal(14, 4)
  source    RateSource
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([currency, date])
}

model Transaction {
  id              String               @id @default(cuid())
  type            TransactionType
  accountId       String
  categoryId      String?
  amount          Decimal              @db.Decimal(12, 2)
  currency        Currency
  rateToArs       Decimal              @default(1) @db.Decimal(14, 4)
  amountArs       Decimal              @db.Decimal(14, 2)
  description     String?
  date            DateTime
  source          TransactionSource    @default(MANUAL)
  reconciled      Boolean              @default(false)
  invoiceId       String?              @unique
  externalId      String?              @unique
  transferGroupId String?
  createdById     String?
  account         FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([date])
  @@index([type])
  @@index([accountId])
  @@index([categoryId])
  @@index([transferGroupId])
}

model Ticket {
  id          String         @id @default(cuid())
  clientId    String
  softwareId  String
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software       @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([softwareId])
  @@index([status])
}

model ReminderLog {
  id         String              @id @default(cuid())
  invoiceId  String
  kind       ReminderKind
  channel    NotificationChannel
  status     ReminderStatus      @default(PENDING)
  recipient  String
  providerId String?
  error      String?
  attempts   Int                 @default(0)
  sentAt     DateTime?
  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([invoiceId, kind, channel])
  @@index([status])
}
